# Gemini API Key (Get from Google AI Studio free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama Configuration
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_HOST=http://localhost:11434

# Model Paths
WAKE_WORD_MODEL_PATH=./models/hey_atlas.onnx
WHISPER_MODEL_SIZE=small
PIPER_VOICE_PATH=./models/en_US-piper.onnx

# Audit & Storage Paths
AUDIT_LOG_PATH=./storage/audit.jsonl

# Safety & Confirmation Settings
CONFIRMATION_TIMEOUT_S=15

# Phone Bridge Configuration
PHONE_IP=192.168.1.100
PHONE_PORT=8765
ADB_DEVICE_ID=
